# --- Connection to the Render control plane (REQUIRED) ---
# Base URL of your deployed app, including the /api prefix.
API_BASE_URL=https://anime-morpher.onrender.com/api
# Must EXACTLY match the WORKER_TOKEN env var set on Render.
WORKER_TOKEN=replace-with-the-same-long-random-string-as-render

# --- Worker identity / polling (optional) ---
# Stable id for this worker; defaults to the machine hostname.
WORKER_ID=
# Seconds to wait between polls when no job is available.
POLL_INTERVAL=5
# Scratch directory for downloads/frames. Wiped per job.
WORK_DIR=/tmp/animemorph

# --- ComfyUI styling backend (REQUIRED for real conversion) ---
# URL of the ComfyUI server running on this GPU box.
COMFYUI_URL=http://127.0.0.1:8188
# Checkpoint file name as it appears in ComfyUI's models/checkpoints folder.
COMFYUI_CKPT=anything-v5.safetensors
# img2img denoise strength. Lower = closer to source (better temporal
# stability for video), higher = stronger stylization. 0.45-0.65 is a good range.
COMFYUI_DENOISE=0.55

# --- Video handling (optional) ---
# Frames are sampled/reassembled at this fps cap. Lower = far fewer frames to
# stylize on long clips (a 10-min clip at 24fps is ~14k frames). 12-15 keeps
# motion smooth while roughly halving the work vs 24fps.
MAX_FPS=15
